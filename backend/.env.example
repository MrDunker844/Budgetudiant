# Copier ce fichier en .env (il n'est jamais commité)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Mot de passe de la base Docker locale (choisissez-en un, il ne peut pas être vide)
DB_PASSWORD=budget
DB_NAME=budget_etudiant

# Generate a unique value with: openssl rand -hex 32
AUTH_SECRET=
AUTH_COOKIE_SECURE=false
# In production, set this to the HTTPS frontend origin and enable secure cookies.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
